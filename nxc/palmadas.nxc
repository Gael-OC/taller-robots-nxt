// Bailarin de palmadas: 1a palmada = toca La Cucaracha y baila, 2a = para.
// Sensor de sonido en IN_2. Motores en B y C (OnRev = avanzar en este montaje).
// Pantalla: linea 0 = nivel de ruido (0-100), linea 1 = 0 espera / 1 bailando.
// Si se para solo: sube UMBRAL. Si no detecta la palmada: baja UMBRAL.

int notaCucaracha(int paso)
{
  if (paso < 3) return TONE_C5;
  if (paso == 3) return TONE_F5;
  if (paso == 4) return TONE_A5;
  if (paso < 8) return TONE_C5;
  if (paso == 8) return TONE_F5;
  if (paso == 9) return TONE_A5;
  if (paso < 12) return TONE_F5;
  if (paso < 14) return TONE_E5;
  if (paso < 16) return TONE_D5;
  if (paso < 20) return TONE_C5;
  if (paso == 20) return TONE_E5;
  if (paso == 21) return TONE_G5;
  if (paso < 25) return TONE_C5;
  if (paso == 25) return TONE_E5;
  if (paso == 26) return TONE_G5;
  if (paso == 27) return TONE_C5;
  if (paso == 28) return TONE_D5;
  if (paso == 29) return TONE_C5;
  if (paso == 30) return TONE_AS4;
  if (paso == 31) return TONE_A4;
  if (paso == 32) return TONE_G4;
  return TONE_F4;
}

// Tempo del estribillo: 1 = corchea (130 ms), 2 = negra, 4 = larga.
// Las pausas entre frases (respiros) son parte de la cancion.
int durCucaracha(int paso)
{
  if (paso == 3 || paso == 8) return 260;
  if (paso == 20 || paso == 25) return 260;
  if (paso == 4) return 390;
  if (paso == 9 || paso == 16 || paso == 26) return 520;
  if (paso == 33) return 390;
  return 130;
}

int restCucaracha(int paso)
{
  if (paso == 4) return 150;
  if (paso == 9 || paso == 26 || paso == 33) return 300;
  if (paso == 16) return 200;
  if (paso == 20 || paso == 21 || paso == 25) return 130;
  return 0;
}

task main()
{
  SetSensorSound(IN_2);
  Wait(200);

  int UMBRAL = 90; // palmada fuerte de cerca ~90-100. No usar 100: solo el 100 exacto lo activa y queda sordo.
  int REARME = 60; // el ruido debe bajar de aqui antes de aceptar otra palmada (aula ruidosa ~40-50)
  int VOL = 3; // volumen musica 0-4. A 3 se oye claro sin auto-dispararse con UMBRAL 90.
  int dur;       // duracion de la nota actual (tempo de la cancion)
  int resto;     // respiro despues de la nota (parte de la cancion)
  int muestras;  // cuantas veces se escucha el micro en la pausa
  int ruido;
  int bailando = 0;
  int armado = 1;
  int fuertes;     // lecturas fuertes seguidas (anti picos del motor)
  int paso = 0;
  int ciego;       // notas iniciales donde se ignora el micro (eco de la 1a palmada)
  int i;

  TextOut(0, LCD_LINE2, "PALMADA:    ");
  TextOut(0, LCD_LINE3, "1=BAILA 2=PARA");

  while (true)
  {
    if (!bailando)
    {
      Off(OUT_BC);
      NumOut(48, LCD_LINE2, 0); // muestra 0 = esperando
      ruido = Sensor(IN_2);
      NumOut(0, LCD_LINE1, ruido);

      if (ruido <= REARME) armado = 1;

      // Pide 2 lecturas fuertes seguidas para aceptar la 1a palmada.
      if (ruido >= UMBRAL && armado)
      {
        fuertes = 1;
        Wait(30);
        ruido = Sensor(IN_2);
        NumOut(0, LCD_LINE1, ruido);
        if (ruido >= UMBRAL) fuertes = 2;

        if (fuertes >= 2)
        {
          bailando = 1;
          armado = 0;
          paso = 0;
          ciego = 4; // ignora el micro durante las 4 primeras notas (~1.5 seg)
          PlayToneEx(TONE_G5, 120, VOL, 0);
          Wait(150);
        }
      }
      Wait(30);
    }
    else
    {
      NumOut(48, LCD_LINE2, 1); // muestra 1 = bailando
      dur = durCucaracha(paso);
      resto = restCucaracha(paso);
      PlayToneEx(notaCucaracha(paso), dur, VOL, 0);

      // Baile al tempo: cada paso de baile dura lo que dura su nota.
      // Nota larga = movimiento largo; respiro = quieto.
      if ((paso % 4) == 0)
        OnRev(OUT_BC, 70);
      else if ((paso % 4) == 1)
      {
        OnRev(OUT_B, 70);
        OnFwd(OUT_C, 70);
      }
      else if ((paso % 4) == 2)
        OnFwd(OUT_BC, 70);
      else
      {
        OnFwd(OUT_B, 70);
        OnRev(OUT_C, 70);
      }

      Wait(dur + 20); // baila mientras suena la nota
      Off(OUT_BC);
      StopSound(); // corta cualquier resto del altavoz
      Wait(20); // silencio: se apaga el eco del altavoz

      // Escucha en el respiro: la 2a palmada cae aqui. A mas respiro, mas facil pararlo.
      muestras = 5 + resto / 25;
      fuertes = 0;
      for (i = 0; i < muestras && bailando; i++)
      {
        Wait(25);
        ruido = Sensor(IN_2);
        NumOut(0, LCD_LINE1, ruido);
        if (ruido <= REARME)
        {
          armado = 1;
          fuertes = 0;
        }
        else if (ruido >= UMBRAL && armado && ciego <= 0)
        {
          fuertes++;
          if (fuertes >= 2) // 2 seguidas = palmada real, no pico del motor
          {
            bailando = 0;
            armado = 0;
            Off(OUT_BC);
            StopSound();
            PlayToneEx(TONE_C4, 300, VOL, 0);
            Wait(350);
          }
        }
        else if (ruido < UMBRAL)
        {
          fuertes = 0;
        }
      }

      if (ciego > 0) ciego--;
      paso++;
      if (paso >= 34) paso = 0;
    }
  }
}
